{
  "name": "comfyui-ts-nodes-vizard-ui",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "npm run typecheck && vite build --configLoader runner",
    "build:catalog": "python tools/catalog.py build",
    "check": "npm run typecheck && npm run test -- --run && python tools/catalog.py validate",
    "dev": "vite --configLoader runner",
    "test": "vitest --configLoader runner",
    "typecheck": "tsc --noEmit",
    "watch": "vite build --watch --configLoader runner"
  },
  "dependencies": {
    "@noble/ed25519": "^2.2.3",
    "dompurify": "^3.2.6",
    "marked": "^15.0.12",
    "minisearch": "^7.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@comfyorg/comfyui-frontend-types": "1.48.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@comfyorg/comfyui-desktop-bridge-types": "0.1.2"
  }
}
