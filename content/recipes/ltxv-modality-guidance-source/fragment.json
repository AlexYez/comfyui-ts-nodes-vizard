{
  "$schema": "../../schemas/recipe-fragment.schema.v1.json",
  "schemaVersion": "1.0",
  "fragmentId": "fragment.ltxv-modality-guidance-source",
  "title": "LTXV-AV modality guidance перед dual CFG",
  "externalInputs": [
    {"id": "model", "type": "MODEL", "to": "modality", "input": "model"},
    {"id": "positive", "type": "CONDITIONING", "to": "guider", "input": "positive"},
    {"id": "negative", "type": "CONDITIONING", "to": "guider", "input": "negative"}
  ],
  "nodes": [
    {
      "ref": "modality",
      "classType": "LTXVModalityGuidance",
      "role": "Добавить дополнительный проход без a2v/v2a cross-attention",
      "settings": {"modality_scale": 3.0, "start_percent": 0.0, "end_percent": 1.0}
    },
    {
      "ref": "guider",
      "classType": "LTXVDualCFGGuider",
      "role": "Создать guider с отдельными CFG для video и audio",
      "settings": {"video_cfg": 3.0, "audio_cfg": 7.0}
    }
  ],
  "connections": [
    {"from": "modality", "output": "MODEL", "to": "guider", "input": "model"}
  ]
}
