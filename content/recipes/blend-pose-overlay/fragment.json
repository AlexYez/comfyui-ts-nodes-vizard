{
  "$schema": "../../schemas/recipe-fragment.schema.v1.json",
  "schemaVersion": "1.0",
  "fragmentId": "fragment.blend-pose-overlay",
  "title": "Два IMAGE — normal 0.5 — preview",
  "externalInputs": [
    {"id": "base_image", "type": "IMAGE", "to": "blend", "input": "image1"},
    {"id": "overlay_image", "type": "IMAGE", "to": "blend", "input": "image2"}
  ],
  "nodes": [
    {
      "ref": "blend",
      "classType": "ImageBlend",
      "role": "Совместить базовый кадр и служебную разметку поровну",
      "settings": {"blend_factor": 0.5, "blend_mode": "normal"}
    },
    {
      "ref": "preview",
      "classType": "PreviewImage",
      "role": "Проверить совпадение геометрии двух слоёв",
      "settings": {}
    }
  ],
  "connections": [
    {"from": "blend", "output": "IMAGE", "to": "preview", "input": "images"}
  ]
}
