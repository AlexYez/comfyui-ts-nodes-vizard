{
  "$schema": "../../schemas/recipe-fragment.schema.v1.json",
  "schemaVersion": "1.0",
  "fragmentId": "fragment.create-model-only-lora-hook",
  "title": "Model-only LoRA → HOOKS → CONDITIONING",
  "externalInputs": [
    {"id": "conditioning", "type": "CONDITIONING", "to": "attach", "input": "cond_NEW"}
  ],
  "nodes": [
    {
      "ref": "create-hook",
      "classType": "CreateHookLoraModelOnly",
      "role": "Создать весовой хук LoRA только для модели",
      "settings": {"lora_name": "SELECT_LORA_FILE", "strength_model": 1.0}
    },
    {
      "ref": "attach",
      "classType": "ConditioningSetProperties",
      "role": "Прикрепить модельный хук к готовому conditioning",
      "settings": {"strength": 1.0, "set_cond_area": "default"}
    }
  ],
  "connections": [
    {"from": "create-hook", "output": "HOOKS", "to": "attach", "input": "hooks"}
  ]
}
