{
  "$schema": "../../schemas/recipe-fragment.schema.v1.json",
  "schemaVersion": "1.0",
  "fragmentId": "fragment.load-unclip-image-conditioning",
  "title": "unCLIP checkpoint → image embedding → conditioning metadata",
  "externalInputs": [
    {"id": "reference_image", "type": "IMAGE", "to": "encode", "input": "image"},
    {"id": "positive", "type": "CONDITIONING", "to": "apply", "input": "conditioning"}
  ],
  "nodes": [
    {
      "ref": "checkpoint",
      "classType": "unCLIPCheckpointLoader",
      "role": "Извлечь MODEL, CLIP, VAE и встроенный CLIP Vision",
      "settings": {"ckpt_name": "выберите совместимый SD 2.1 unCLIP checkpoint"}
    },
    {
      "ref": "encode",
      "classType": "CLIPVisionEncode",
      "role": "Получить image embedding из внешнего референса",
      "settings": {"crop": "center"}
    },
    {
      "ref": "apply",
      "classType": "unCLIPConditioning",
      "role": "Добавить image embedding к positive conditioning",
      "settings": {"strength": 1.0, "noise_augmentation": 0.0}
    }
  ],
  "connections": [
    {"from": "checkpoint", "output": "CLIP_VISION", "to": "encode", "input": "clip_vision"},
    {"from": "encode", "output": "CLIP_VISION_OUTPUT", "to": "apply", "input": "clip_vision_output"}
  ]
}
