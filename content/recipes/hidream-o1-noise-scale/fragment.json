      "settings": {"noise_scale": 8.0}
    },
    {
      "ref": "scheduler",
      "classType": "BasicScheduler",
      "role": "Построить official normal SIGMAS на 40 шагов",
      "settings": {"scheduler": "normal", "steps": 40, "denoise": 1.0}
    }
  ],
  "connections": [
    {"from": "noise_scale", "output": "MODEL", "to": "scheduler", "input": "model"}
  ]
}

