{
  "$schema": "../../schemas/recipe-fragment.schema.v1.json",
  "schemaVersion": "1.0",
  "fragmentId": "fragment.hidream-o1-noise-scale",
  "title": "HiDream-O1 base MODEL → noise scale 8.0 → normal scheduler",
