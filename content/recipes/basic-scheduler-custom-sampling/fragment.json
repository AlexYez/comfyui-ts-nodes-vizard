{
  "$schema": "../../schemas/recipe-fragment.schema.v1.json",
  "schemaVersion": "1.0",
  "fragmentId": "fragment.basic-scheduler-custom-sampling",
  "title": "BasicScheduler simple/20/1 перед SamplerCustomAdvanced",
  "externalInputs": [
    {"id": "model", "type": "MODEL", "to": "schedule", "input": "model"},
    {"id": "noise", "type": "NOISE", "to": "sample", "input": "noise"},
    {"id": "guider", "type": "GUIDER", "to": "sample", "input": "guider"},
    {"id": "sampler", "type": "SAMPLER", "to": "sample", "input": "sampler"},
    {"id": "latent", "type": "LATENT", "to": "sample", "input": "latent_image"}
  ],
  "nodes": [
    {
      "ref": "schedule",
      "classType": "BasicScheduler",
      "role": "Построить SIGMAS по model_sampling",
      "settings": {"scheduler": "simple", "steps": 20, "denoise": 1.0}
    },
    {
      "ref": "sample",
      "classType": "SamplerCustomAdvanced",
      "role": "Использовать подготовленное расписание",
      "settings": {}
    }
  ],
  "connections": [
    {"from": "schedule", "output": "SIGMAS", "to": "sample", "input": "sigmas"}
  ]
}
