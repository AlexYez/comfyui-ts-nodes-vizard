{
  "$schema": "../../schemas/recipe-fragment.schema.v1.json",
  "schemaVersion": "1.0",
  "fragmentId": "fragment.discrete-vprediction-model-sampling",
  "title": "ModelSamplingDiscrete V-prediction → BasicScheduler",
  "externalInputs": [
    {"id": "model", "type": "MODEL", "to": "patch", "input": "model"}
  ],
  "nodes": [
    {
      "ref": "patch",
      "classType": "ModelSamplingDiscrete",
      "role": "Поставить дискретную V-prediction sampling-схему",
      "settings": {"sampling": "v_prediction", "zsnr": false}
    },
    {
      "ref": "schedule",
      "classType": "BasicScheduler",
      "role": "Построить SIGMAS из того же patched MODEL",
      "settings": {"scheduler": "simple", "steps": 20, "denoise": 1.0}
    }
  ],
  "connections": [
    {"from": "patch", "output": "MODEL", "to": "schedule", "input": "model"}
  ]
}
