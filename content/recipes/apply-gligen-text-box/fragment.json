{
  "$schema": "../../schemas/recipe-fragment.schema.v1.json",
  "schemaVersion": "1.0",
  "fragmentId": "fragment.apply-gligen-text-box",
  "title": "GLIGEN-модель и одна текстовая рамка",
  "externalInputs": [
    {"id": "positive", "type": "CONDITIONING", "to": "apply", "input": "conditioning_to"},
    {"id": "clip", "type": "CLIP", "to": "apply", "input": "clip"}
  ],
  "nodes": [
    {
      "ref": "loader",
      "classType": "GLIGENLoader",
      "role": "Загрузить совместимую GLIGEN textbox model",
      "settings": {"gligen_name": "выберите совместимый GLIGEN textbox checkpoint"}
    },
    {
      "ref": "apply",
      "classType": "GLIGENTextBoxApply",
      "role": "Добавить текст и прямоугольник в conditioning metadata",
      "settings": {"text": "красный куб", "width": 256, "height": 256, "x": 128, "y": 128}
    }
  ],
  "connections": [
    {"from": "loader", "output": "GLIGEN", "to": "apply", "input": "gligen_textbox_model"}
  ]
}
