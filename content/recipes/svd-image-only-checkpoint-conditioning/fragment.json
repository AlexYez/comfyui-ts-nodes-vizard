{
  "$schema": "../../schemas/recipe-fragment.schema.v1.json",
  "schemaVersion": "1.0",
  "fragmentId": "fragment.svd-image-only-checkpoint-conditioning",
  "title": "Контрольная точка SVD-XT + IMAGE → условия и настроенная MODEL",
  "externalInputs": [
    {"id": "init_image", "type": "IMAGE", "to": "conditioning", "input": "init_image"}
  ],
  "nodes": [
    {
      "ref": "loader",
      "classType": "ImageOnlyCheckpointLoader",
      "role": "Загрузить MODEL, CLIP_VISION и VAE из официальной контрольной точки SVD-XT",
      "settings": {"ckpt_name": "svd_xt.safetensors"}
    },
    {
      "ref": "conditioning",
      "classType": "SVD_img2vid_Conditioning",
      "role": "Подготовить положительные и отрицательные условия и пустой видеолатент",
      "settings": {"width": 1024, "height": 576, "video_frames": 25, "motion_bucket_id": 127, "fps": 6, "augmentation_level": 0.0}
    },
    {
      "ref": "guidance",
      "classType": "VideoLinearCFGGuidance",
      "role": "Задать начальный коэффициент линейного CFG перед внешним сэмплером",
      "settings": {"min_cfg": 1.0}
    }
  ],
  "connections": [
    {"from": "loader", "output": "CLIP_VISION", "to": "conditioning", "input": "clip_vision"},
    {"from": "loader", "output": "VAE", "to": "conditioning", "input": "vae"},
    {"from": "loader", "output": "MODEL", "to": "guidance", "input": "model"}
  ]
}
