{
  "$schema": "../../schemas/recipe-fragment.schema.v1.json",
  "schemaVersion": "1.0",
  "fragmentId": "fragment.mediapipe-face-mask",
  "title": "IMAGE — MediaPipe face landmarks — маска овала",
  "externalInputs": [
    {"id": "input_image", "type": "IMAGE", "to": "detector", "input": "image"}
  ],
  "nodes": [
    {
      "ref": "loader",
      "classType": "LoadMediaPipeFaceLandmarker",
      "role": "Загрузить локальные веса short/full, сетку и эталонную геометрию",
      "settings": {"model_name": "mediapipe_face_fp32.safetensors"}
    },
    {
      "ref": "detector",
      "classType": "MediaPipeFaceLandmarker",
      "role": "Найти все лица и вернуть ориентиры каждого кадра",
      "settings": {"detector_variant": "full", "num_faces": 0, "min_confidence": 0.5, "missing_frame_fallback": "empty"}
    },
    {
      "ref": "mask",
      "classType": "MediaPipeFaceMask",
      "role": "Залить только внешний овал каждого найденного лица",
      "settings": {"regions": {"regions": "custom", "face_oval": true, "lips": false, "left_eye": false, "right_eye": false, "irises": false}}
    }
  ],
  "connections": [
    {"from": "loader", "output": "FACE_DETECTION_MODEL", "to": "detector", "input": "face_detection_model"},
    {"from": "detector", "output": "face_landmarks", "to": "mask", "input": "face_landmarks"}
  ]
}
