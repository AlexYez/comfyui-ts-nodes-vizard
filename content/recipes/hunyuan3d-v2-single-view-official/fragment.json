{
  "$schema": "../../schemas/recipe-fragment.schema.v1.json",
  "schemaVersion": "1.0",
  "fragmentId": "fragment.hunyuan3d-v2-single-view-official",
  "title": "Hunyuan3D v2: изображение → воксели → сетка",
  "externalInputs": [
    {"id": "model", "type": "MODEL", "to": "model_sampling", "input": "model"},
    {"id": "clip_vision", "type": "CLIP_VISION", "to": "encode", "input": "clip_vision"},
    {"id": "image", "type": "IMAGE", "to": "encode", "input": "image"},
    {"id": "vae", "type": "VAE", "to": "decode", "input": "vae"}
  ],
  "nodes": [
    {
      "ref": "encode",
      "classType": "CLIPVisionEncode",
      "role": "Закодировать изображение без центральной обрезки, как в официальном шаблоне",
      "settings": {"crop": "none"}
    },
    {
      "ref": "conditioning",
      "classType": "Hunyuan3Dv2Conditioning",
      "role": "Построить положительное условие из last_hidden_state и нулевое отрицательное условие",
      "settings": {}
    },
    {
      "ref": "empty",
      "classType": "EmptyLatentHunyuan3Dv2",
      "role": "Создать нулевой латент Hunyuan3D v2",
      "settings": {"resolution": 3072, "batch_size": 1}
    },
    {
      "ref": "model_sampling",
      "classType": "ModelSamplingAuraFlow",
      "role": "Применить сдвиг модели из официального шаблона",
      "settings": {"shift": 1.0000000000000002}
    },
    {
      "ref": "sample",
      "classType": "KSampler",
      "role": "Получить латент геометрии по визуальному условию",
      "settings": {
        "seed": 242832339647017,
        "steps": 20,
        "cfg": 8.0,
        "sampler_name": "euler",
        "scheduler": "normal",
        "denoise": 1.0
      }
    },
    {
      "ref": "decode",
      "classType": "VAEDecodeHunyuan3D",
      "role": "Декодировать латент в объёмное поле",
      "settings": {"num_chunks": 8000, "octree_resolution": 256}
    },
    {
      "ref": "mesh",
      "classType": "VoxelToMesh",
      "role": "Построить полигональную сетку из поля",
      "settings": {"algorithm": "surface net", "threshold": 0.6}
    }
  ],
  "connections": [
    {"from": "encode", "output": "CLIP_VISION_OUTPUT", "to": "conditioning", "input": "clip_vision_output"},
    {"from": "conditioning", "output": "positive", "to": "sample", "input": "positive"},
    {"from": "conditioning", "output": "negative", "to": "sample", "input": "negative"},
    {"from": "empty", "output": "LATENT", "to": "sample", "input": "latent_image"},
    {"from": "model_sampling", "output": "MODEL", "to": "sample", "input": "model"},
    {"from": "sample", "output": "LATENT", "to": "decode", "input": "samples"},
    {"from": "decode", "output": "VOXEL", "to": "mesh", "input": "voxel"}
  ]
}
