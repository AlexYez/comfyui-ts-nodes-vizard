{
  "$schema": "../../schemas/recipe-fragment.schema.v1.json",
  "schemaVersion": "1.0",
  "fragmentId": "fragment.ltxv-stg-source",
  "title": "LTXV STG block 29 перед Dual CFG",
  "externalInputs": [
