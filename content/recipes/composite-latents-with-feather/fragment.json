{
  "$schema": "../../schemas/recipe-fragment.schema.v1.json",
  "schemaVersion": "1.0",
  "fragmentId": "fragment.composite-latents-with-feather",
  "title": "Два LATENT → composite с feather → VAE preview",
  "externalInputs": [
    {"id": "destination_latent", "type": "LATENT", "to": "composite", "input": "samples_to"},
    {"id": "source_latent", "type": "LATENT", "to": "composite", "input": "samples_from"},
    {"id": "vae", "type": "VAE", "to": "decode", "input": "vae"}
  ],
  "nodes": [
    {
      "ref": "composite",
      "classType": "LatentComposite",
      "role": "Вставить source в destination и смягчить доступные границы",
      "settings": {"x": 64, "y": 64, "feather": 32}
    },
    {"ref": "decode", "classType": "VAEDecode", "role": "Декодировать собранный LATENT совместимым VAE", "settings": {}},
    {"ref": "preview", "classType": "PreviewImage", "role": "Показать результат без нового sampling", "settings": {}}
  ],
  "connections": [
    {"from": "composite", "output": "LATENT", "to": "decode", "input": "samples"},
    {"from": "decode", "output": "IMAGE", "to": "preview", "input": "images"}
  ]
}
