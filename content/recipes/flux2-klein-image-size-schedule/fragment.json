{
  "$schema": "../../schemas/recipe-fragment.schema.v1.json",
  "schemaVersion": "1.0",
  "fragmentId": "fragment.flux2-klein-image-size-schedule",
  "title": "Размер изображения управляет Flux.2 Klein scheduler",
  "externalInputs": [
    {"id": "image", "type": "IMAGE", "to": "size", "input": "image"}
  ],
  "nodes": [
    {
      "ref": "size",
      "classType": "GetImageSize",
      "role": "Получить фактические pixel dimensions редактируемого изображения",
      "settings": {}
    },
    {
      "ref": "scheduler",
      "classType": "Flux2Scheduler",
      "role": "Построить четырёхшаговое distilled-расписание по измеренной площади",
      "settings": {"steps": 4, "width": 1024, "height": 1024}
    }
  ],
  "connections": [
    {"from": "size", "output": "width", "to": "scheduler", "input": "width"},
    {"from": "size", "output": "height", "to": "scheduler", "input": "height"}
  ]
}
