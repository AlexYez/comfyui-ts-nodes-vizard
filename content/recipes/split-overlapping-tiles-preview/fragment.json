{
  "$schema": "../../schemas/recipe-fragment.schema.v1.json",
  "schemaVersion": "1.0",
  "fragmentId": "fragment.split-overlapping-tiles-preview",
  "title": "IMAGE — список перекрывающихся тайлов — диагностическая сетка",
  "externalInputs": [
    {"id": "image", "type": "IMAGE", "to": "split", "input": "image"}
  ],
  "nodes": [
    {"ref": "split", "classType": "SplitImageToTileList", "role": "Нарезать IMAGE в row-major список тайлов", "settings": {"tile_width": 1024, "tile_height": 1024, "overlap": 128}},
    {"ref": "grid", "classType": "ImageGrid", "role": "Показать list-элементы по четыре в строке", "settings": {"columns": 4, "cell_width": 256, "cell_height": 256, "padding": 4}},
    {"ref": "preview", "classType": "PreviewImage", "role": "Показать диагностический коллаж", "settings": {}}
  ],
  "connections": [
    {"from": "split", "output": "IMAGE", "to": "grid", "input": "images"},
    {"from": "grid", "output": "images", "to": "preview", "input": "images"}
  ]
}
