{
  "$schema": "../../schemas/recipe-fragment.schema.v1.json",
  "schemaVersion": "1.0",
  "fragmentId": "fragment.ltxv-shape-aware-sampling",
  "title": "LTXV shape-aware MODEL перед BasicScheduler",
  "externalInputs": [
    {"id": "model", "type": "MODEL", "to": "patch", "input": "model"},
    {"id": "latent", "type": "LATENT", "to": "patch", "input": "latent"}
  ],
  "nodes": [
    {
      "ref": "patch",
      "classType": "ModelSamplingLTXV",
      "role": "Рассчитать shift по форме sampling latent",
      "settings": {"max_shift": 2.05, "base_shift": 0.95}
    },
    {
      "ref": "schedule",
      "classType": "BasicScheduler",
      "role": "Построить simple SIGMAS на изменённом MODEL",
      "settings": {"scheduler": "simple", "steps": 20, "denoise": 1.0}
    }
  ],
  "connections": [
    {"from": "patch", "output": "MODEL", "to": "schedule", "input": "model"}
  ]
}
