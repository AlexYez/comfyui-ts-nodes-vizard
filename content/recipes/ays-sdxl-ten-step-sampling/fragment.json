      "settings": {"model_type": "SDXL", "steps": 10, "denoise": 1.0}
    },
    {
      "ref": "sample",
      "classType": "SamplerCustomAdvanced",
      "role": "Использовать подготовленные SIGMAS с внешними компонентами",
      "settings": {}
    }
  ],
  "connections": [
    {"from": "schedule", "output": "SIGMAS", "to": "sample", "input": "sigmas"}
  ]
