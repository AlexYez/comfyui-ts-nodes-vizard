{
  "$schema": "../../schemas/recipe-fragment.schema.v1.json",
  "schemaVersion": "1.0",
  "fragmentId": "fragment.wan-temporal-attention-chain",
  "title": "ModelSamplingSD3 → временное внимание → CFGZeroStar → KSampler",
  "externalInputs": [
    {"id": "model", "type": "MODEL", "to": "sampling", "input": "model"},
    {"id": "positive", "type": "CONDITIONING", "to": "sample", "input": "positive"},
    {"id": "negative", "type": "CONDITIONING", "to": "sample", "input": "negative"},
    {"id": "latent", "type": "LATENT", "to": "sample", "input": "latent_image"}
  ],
  "nodes": [
    {"ref": "sampling", "classType": "ModelSamplingSD3", "role": "Назначить схему сэмплирования с shift 5", "settings": {"shift": 5.000000000000001}},
    {"ref": "temporal-attention", "classType": "UNetTemporalAttentionMultiply", "role": "Раздельно усилить выходы структурного и временного перекрёстного внимания", "settings": {"self_structural": 1.0, "self_temporal": 1.0, "cross_structural": 1.2, "cross_temporal": 1.3}},
    {"ref": "zero-star", "classType": "CFGZeroStar", "role": "Добавить коррекцию CFG-Zero*", "settings": {}},
    {"ref": "sample", "classType": "KSampler", "role": "Выполнить сэмплирование с параметрами официального примера", "settings": {"seed": 887940314022885, "steps": 20, "cfg": 6.0, "sampler_name": "uni_pc", "scheduler": "simple", "denoise": 1.0}}
  ],
  "connections": [
    {"from": "sampling", "output": "MODEL", "to": "temporal-attention", "input": "model"},
    {"from": "temporal-attention", "output": "MODEL", "to": "zero-star", "input": "model"},
    {"from": "zero-star", "output": "patched_model", "to": "sample", "input": "model"}
  ]
}
