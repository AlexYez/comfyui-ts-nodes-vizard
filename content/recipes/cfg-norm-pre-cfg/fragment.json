{
  "$schema": "../../schemas/recipe-fragment.schema.v1.json",
  "schemaVersion": "1.0",
  "fragmentId": "fragment.cfg-norm-pre-cfg",
  "title": "CFGNorm strength 1 с pre_cfg=true",
  "externalInputs": [
    {"id": "model", "type": "MODEL", "to": "norm", "input": "model"},
    {"id": "positive", "type": "CONDITIONING", "to": "sample", "input": "positive"},
    {"id": "negative", "type": "CONDITIONING", "to": "sample", "input": "negative"},
    {"id": "latent", "type": "LATENT", "to": "sample", "input": "latent_image"}
  ],
  "nodes": [
    {"ref": "norm", "classType": "CFGNorm", "role": "Заменить standard CFG combine нормализованной формулой", "settings": {"strength": 1.0, "pre_cfg": true}},
    {"ref": "sample", "classType": "KSampler", "role": "Выполнить sampling с официальными JoyAI settings", "settings": {"seed": 42, "steps": 40, "cfg": 4.0, "sampler_name": "euler", "scheduler": "normal", "denoise": 1.0}}
  ],
  "connections": [
    {"from": "norm", "output": "patched_model", "to": "sample", "input": "model"}
  ]
}
