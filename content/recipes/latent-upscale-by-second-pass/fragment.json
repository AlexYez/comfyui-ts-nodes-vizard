{
  "$schema": "../../schemas/recipe-fragment.schema.v1.json",
  "schemaVersion": "1.0",
  "fragmentId": "fragment.latent-upscale-by-second-pass",
  "title": "LATENT — nearest-exact × 1.5 — второй KSampler",
  "externalInputs": [
    {
      "id": "first_pass_latent",
      "type": "LATENT",
      "to": "upscale",
      "input": "samples"
    },
    {
      "id": "model",
      "type": "MODEL",
      "to": "sampler",
      "input": "model"
    },
    {
      "id": "positive",
      "type": "CONDITIONING",
      "to": "sampler",
      "input": "positive"
    },
    {
      "id": "negative",
      "type": "CONDITIONING",
      "to": "sampler",
      "input": "negative"
    },
    {
      "id": "vae",
      "type": "VAE",
      "to": "decode",
      "input": "vae"
    }
  ],
  "nodes": [
    {
      "ref": "upscale",
      "classType": "LatentUpscaleBy",
      "role": "Увеличить обе стороны latent-grid в 1,5 раза",
      "settings": {
        "upscale_method": "nearest-exact",
        "scale_by": 1.5
      }
    },
    {
      "ref": "sampler",
      "classType": "KSampler",
      "role": "Уточнить интерполированный latent вторым проходом",
      "settings": {
        "seed": 469771404043268,
        "steps": 14,
        "cfg": 8.0,
        "sampler_name": "dpmpp_2m",
        "scheduler": "simple",
        "denoise": 0.5
      }
    },
    {
      "ref": "decode",
      "classType": "VAEDecode",
      "role": "Декодировать результат совместимым VAE",
      "settings": {}
    },
    {
      "ref": "save",
      "classType": "SaveImage",
      "role": "Сохранить результат второго прохода",
      "settings": {
        "filename_prefix": "ComfyUI"
      }
    }
  ],
  "connections": [
    {
      "from": "upscale",
      "output": "LATENT",
      "to": "sampler",
      "input": "latent_image"
    },
    {
      "from": "sampler",
      "output": "LATENT",
      "to": "decode",
      "input": "samples"
    },
    {
      "from": "decode",
      "output": "IMAGE",
