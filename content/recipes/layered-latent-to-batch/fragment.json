{
  "$schema": "../../schemas/recipe-fragment.schema.v1.json",
  "schemaVersion": "1.0",
  "fragmentId": "fragment.layered-latent-to-batch",
  "title": "Layered LATENT → убрать первый элемент → batch слоёв",
  "externalInputs": [
    {
      "id": "layered_latent",
      "type": "LATENT",
      "to": "drop_first",
      "input": "samples"
    }
  ],
  "nodes": [
    {
      "ref": "drop_first",
      "classType": "LatentCut",
      "role": "Отбросить первый элемент третьей оси с конца",
      "settings": {
        "dim": "t",
        "index": 1,
        "amount": 16384
      }
    },
    {
      "ref": "layers_to_batch",
      "classType": "LatentCutToBatch",
      "role": "Перенести каждый оставшийся элемент оси t в batch",
      "settings": {
        "dim": "t",
        "slice_size": 1
      }
    }
  ],
  "connections": [
    {
      "from": "drop_first",
      "output": "LATENT",
      "to": "layers_to_batch",
      "input": "samples"
    }
  ]
}

