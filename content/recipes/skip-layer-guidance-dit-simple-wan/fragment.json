{
  "$schema": "../../schemas/recipe-fragment.schema.v1.json",
  "schemaVersion": "1.0",
  "fragmentId": "fragment.skip-layer-guidance-dit-simple-wan",
  "title": "Wan Dancer: ModelSamplingSD3 → Simple SLG → scheduler и guider",
  "externalInputs": [
    {"id": "model", "type": "MODEL", "to": "sampling", "input": "model"},
    {"id": "positive", "type": "CONDITIONING", "to": "guider", "input": "positive"},
    {"id": "negative", "type": "CONDITIONING", "to": "guider", "input": "negative"}
  ],
  "nodes": [
    {"ref": "sampling", "classType": "ModelSamplingSD3", "role": "Применить Wan Dancer sampling shift", "settings": {"shift": 5.0}},
    {
      "ref": "slg",
      "classType": "SkipLayerGuidanceDiTSimple",
      "role": "Обойти double-блок 9 в unconditional-проходе",
      "settings": {"double_layers": "9", "single_layers": "", "start_percent": 0.0, "end_percent": 1.0}
    },
    {"ref": "scheduler", "classType": "BasicScheduler", "role": "Построить официальное расписание 48 steps", "settings": {"scheduler": "simple", "steps": 48, "denoise": 1.0}},
    {"ref": "guider", "classType": "CFGGuider", "role": "Создать guider с явно ненулевой unconditional-ветвью", "settings": {"cfg": 3.0}}
  ],
  "connections": [
    {"from": "sampling", "output": "MODEL", "to": "slg", "input": "model"},
    {"from": "slg", "output": "MODEL", "to": "scheduler", "input": "model"},
    {"from": "slg", "output": "MODEL", "to": "guider", "input": "model"}
  ]
}
