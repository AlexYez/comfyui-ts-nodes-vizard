{
  "$schema": "../../schemas/recipe-fragment.schema.v1.json",
  "schemaVersion": "1.0",
  "fragmentId": "fragment.image-scale-by-save",
  "title": "LoadImage — ImageScaleBy × 2 — SaveImage",
  "externalInputs": [],
  "nodes": [
    {
      "ref": "load",
      "classType": "LoadImage",
      "role": "Загрузить исходное изображение",
      "settings": {
        "image": "выберите входной файл"
      }
    },
    {
      "ref": "scale",
      "classType": "ImageScaleBy",
      "role": "Удвоить обе стороны методом lanczos",
      "settings": {
        "upscale_method": "lanczos",
        "scale_by": 2.0
      }
    },
    {
      "ref": "save",
      "classType": "SaveImage",
      "role": "Сохранить увеличенное изображение",
      "settings": {
        "filename_prefix": "ComfyUI"
      }
    }
  ],
  "connections": [
    {
      "from": "load",
      "output": "IMAGE",
      "to": "scale",
      "input": "image"
    },
    {
      "from": "scale",
      "output": "IMAGE",
      "to": "save",
      "input": "images"
    }
  ]
}
