{
  "$schema": "../../schemas/recipe-fragment.schema.v1.json",
  "schemaVersion": "1.0",
  "fragmentId": "fragment.flux-resolution-sampling-branch",
  "title": "Flux 1024×1024 fan-out в guider и scheduler",
  "externalInputs": [
    {"id": "model", "type": "MODEL", "to": "patch", "input": "model"},
    {"id": "conditioning", "type": "CONDITIONING", "to": "guide", "input": "conditioning"}
  ],
  "nodes": [
    {
      "ref": "patch",
      "classType": "ModelSamplingFlux",
      "role": "Рассчитать Flux shift для 1024×1024",
      "settings": {"max_shift": 1.15, "base_shift": 0.5, "width": 1024, "height": 1024}
    },
    {
      "ref": "guide",
      "classType": "BasicGuider",
      "role": "Создать guider из изменённого MODEL",
      "settings": {}
    },
    {
      "ref": "schedule",
      "classType": "BasicScheduler",
      "role": "Построить simple SIGMAS на 20 шагов",
      "settings": {"scheduler": "simple", "steps": 20, "denoise": 1.0}
    }
  ],
  "connections": [
    {"from": "patch", "output": "MODEL", "to": "guide", "input": "model"},
    {"from": "patch", "output": "MODEL", "to": "schedule", "input": "model"}
  ]
}
