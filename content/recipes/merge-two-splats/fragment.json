{
  "$schema": "../../schemas/recipe-fragment.schema.v1.json",
  "schemaVersion": "1.0",
  "fragmentId": "fragment.merge-two-splats",
  "title": "SPLAT + SPLAT → MergeSplat → GetSplatCount",
  "externalInputs": [
    {"id": "first-splat", "type": "SPLAT", "to": "merge", "input": "splats.splat0"},
    {"id": "second-splat", "type": "SPLAT", "to": "merge", "input": "splats.splat1"}
  ],
  "nodes": [
    {
      "ref": "merge",
      "classType": "MergeSplat",
      "role": "Конкатенировать реальные гауссы двух входов",
      "settings": {}
    },
    {
      "ref": "count",
      "classType": "GetSplatCount",
      "role": "Показать итоговое число гауссов",
      "settings": {}
