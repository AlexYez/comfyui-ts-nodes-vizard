{
  "$schema": "../../schemas/recipe-fragment.schema.v1.json",
  "schemaVersion": "1.0",
  "fragmentId": "fragment.tcfg-standard-sampling",
  "title": "TCFG перед runtime-default KSampler",
  "externalInputs": [
    {"id": "model", "type": "MODEL", "to": "tcfg", "input": "model"},
    {"id": "positive", "type": "CONDITIONING", "to": "sample", "input": "positive"},
    {"id": "negative", "type": "CONDITIONING", "to": "sample", "input": "negative"},
    {"id": "latent", "type": "LATENT", "to": "sample", "input": "latent_image"}
  ],
  "nodes": [
    {"ref": "tcfg", "classType": "TCFG", "role": "Спроецировать unconditional score перед CFG combine", "settings": {}},
    {"ref": "sample", "classType": "KSampler", "role": "Выполнить стандартный sampling", "settings": {"seed": 0, "steps": 20, "cfg": 8.0, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0}}
  ],
  "connections": [
    {"from": "tcfg", "output": "patched_model", "to": "sample", "input": "model"}
  ]
}
