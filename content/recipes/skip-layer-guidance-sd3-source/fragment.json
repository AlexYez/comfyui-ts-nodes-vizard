{
  "$schema": "../../schemas/recipe-fragment.schema.v1.json",
  "schemaVersion": "1.0",
  "fragmentId": "fragment.skip-layer-guidance-sd3-source",
  "title": "ModelSamplingSD3 → SkipLayerGuidanceSD3 → KSampler",
  "externalInputs": [
    {"id": "model", "type": "MODEL", "to": "sampling", "input": "model"},
    {"id": "positive", "type": "CONDITIONING", "to": "sample", "input": "positive"},
    {"id": "negative", "type": "CONDITIONING", "to": "sample", "input": "negative"},
    {"id": "latent", "type": "LATENT", "to": "sample", "input": "latent_image"}
  ],
  "nodes": [
    {"ref": "sampling", "classType": "ModelSamplingSD3", "role": "Задать sampling до вычисления SLG-окна", "settings": {"shift": 3.0}},
    {
      "ref": "slg",
      "classType": "SkipLayerGuidanceSD3",
      "role": "Добавить source-derived SD3 skip-layer patch",
      "settings": {"layers": "7, 8, 9", "scale": 3.0, "start_percent": 0.01, "end_percent": 0.15}
    },
    {
      "ref": "sample",
      "classType": "KSampler",
      "role": "Проверить patched MODEL в стандартном sampling path",
      "settings": {"seed": 0, "steps": 20, "cfg": 8.0, "sampler_name": "euler", "scheduler": "normal", "denoise": 1.0}
    }
  ],
  "connections": [
    {"from": "sampling", "output": "MODEL", "to": "slg", "input": "model"},
    {"from": "slg", "output": "MODEL", "to": "sample", "input": "model"}
  ]
}
