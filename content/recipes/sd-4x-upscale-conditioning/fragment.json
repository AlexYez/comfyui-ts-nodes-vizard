{
  "$schema": "../../schemas/recipe-fragment.schema.v1.json",
  "schemaVersion": "1.0",
  "fragmentId": "fragment.sd-4x-upscale-conditioning",
  "title": "Low-resolution IMAGE — SD x4 conditioning — KSampler",
  "externalInputs": [
    {"id": "input_image", "type": "IMAGE", "to": "condition", "input": "images"},
    {"id": "positive", "type": "CONDITIONING", "to": "condition", "input": "positive"},
    {"id": "negative", "type": "CONDITIONING", "to": "condition", "input": "negative"},
    {"id": "sd_x4_model", "type": "MODEL", "to": "sample", "input": "model"}
  ],
  "nodes": [
    {"ref": "condition", "classType": "SD_4XUpscale_Conditioning", "role": "Подготовить concat_image, noise_augmentation и целевой latent", "settings": {"scale_ratio": 4.0, "noise_augmentation": 0.0}},
    {"ref": "sample", "classType": "KSampler", "role": "Сгенерировать увеличенное изображение в latent-пространстве", "settings": {"seed": 42, "steps": 20, "cfg": 7.0, "sampler_name": "euler", "scheduler": "normal", "denoise": 1.0}}
  ],
  "connections": [
    {"from": "condition", "output": "positive", "to": "sample", "input": "positive"},
    {"from": "condition", "output": "negative", "to": "sample", "input": "negative"},
    {"from": "condition", "output": "latent", "to": "sample", "input": "latent_image"}
  ]
}
