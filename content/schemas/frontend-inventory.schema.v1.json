{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodes-wizard.local/schemas/frontend-inventory.schema.v1.json",
  "title": "TS Nodes Wizard frontend-only inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "source", "frontendVersion", "capturedAt", "nodes"],
  "properties": {
    "$schema": { "type": "string", "pattern": "frontend-inventory\\.schema\\.v1\\.json$" },
    "schemaVersion": { "const": "1.0" },
    "source": { "type": "string", "minLength": 3 },
    "frontendVersion": { "type": "string", "minLength": 1 },
    "capturedAt": { "type": "string", "format": "date-time" },
    "nodes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["classType"],
        "properties": {
          "classType": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$" },
          "packageId": { "type": "string", "minLength": 1 },
          "dev_only": { "type": "boolean" }
        }
      }
    }
  }
}
