{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodes-wizard.local/schemas/catalog-manifest.schema.v1.json",
  "title": "TS Nodes Wizard source catalog manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "catalogVersion",
    "locale",
    "generatedAt",
    "release",
    "articles",
    "recipes",
    "workflows"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "catalogVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "locale": { "type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "humanApproval"],
      "properties": {
        "channel": { "enum": ["alpha", "beta", "stable"] },
        "humanApproval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "approvedBy", "approvedAt", "note"],
          "properties": {
            "state": { "enum": ["pending", "approved", "rejected"] },
            "approvedBy": { "type": ["string", "null"], "minLength": 2 },
            "approvedAt": { "type": ["string", "null"], "format": "date-time" },
            "note": { "type": "string", "minLength": 10, "maxLength": 500 }
          }
        }
      }
    },
    "articles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": ".+manifest\\.json$" }
    },
    "recipes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": ".+recipe\\.json$" }
    },
    "workflows": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": ".+workflow\\.json$" }
    }
  }
}
