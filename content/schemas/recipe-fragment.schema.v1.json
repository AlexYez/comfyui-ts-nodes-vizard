{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodes-wizard.local/schemas/recipe-fragment.schema.v1.json",
  "title": "TS Nodes Wizard semantic recipe fragment",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "fragmentId", "title", "externalInputs", "nodes", "connections"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "fragmentId": { "type": "string", "pattern": "^fragment\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 3 },
    "externalInputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "to", "input"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "type": { "type": "string", "minLength": 1 },
          "to": { "type": "string" },
          "input": { "type": "string" }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "classType", "role", "settings"],
        "properties": {
          "ref": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "classType": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 2 },
          "settings": { "type": "object" }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "output", "to", "input"],
        "properties": {
          "from": { "type": "string" },
          "output": { "type": "string" },
          "to": { "type": "string" },
          "input": { "type": "string" }
        }
      }
    }
  }
}
