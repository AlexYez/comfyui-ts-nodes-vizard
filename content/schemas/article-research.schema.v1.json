{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodes-wizard.local/schemas/article-research.schema.v1.json",
  "title": "TS Nodes Wizard per-article research record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "articleId",
    "node",
    "baseline",
    "state",
    "reviewMode",
    "evidence",
    "checks",
    "knownGaps",
    "updatedAt"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "1.0" },
    "articleId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classType", "origin"],
      "properties": {
        "classType": { "type": "string", "minLength": 1 },
        "pythonModule": { "type": ["string", "null"], "minLength": 1 },
        "origin": { "enum": ["backend", "frontend", "concept"] }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comfyui", "frontend", "sourceCommit", "embeddedDocs", "workflowTemplatesJson"],
      "properties": {
        "comfyui": { "type": "string", "minLength": 1 },
        "frontend": { "type": "string", "minLength": 1 },
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "embeddedDocs": { "type": "string", "minLength": 1 },
        "workflowTemplatesJson": { "type": "string", "minLength": 1 }
      }
    },
    "state": { "enum": ["source_reviewed", "workflow_reviewed", "fact_checked", "human_approved"] },
    "reviewMode": { "enum": ["automated_assisted", "human"] },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeInventory", "sourceLocations", "embeddedDocs", "workflows"],
      "properties": {
        "runtimeInventory": { "type": "string", "minLength": 1 },
        "sourceLocations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "path", "lines"],
            "properties": {
              "url": { "type": "string", "pattern": "^https://" },
              "path": { "type": "string", "minLength": 1 },
              "lines": { "type": "string", "minLength": 1 }
            }
          }
        },
        "embeddedDocs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["locale", "archivePath", "assessment"],
            "properties": {
              "locale": { "type": "string", "minLength": 2 },
              "archivePath": { "type": "string", "minLength": 1 },
              "assessment": { "type": "string", "minLength": 3 }
            }
          }
        },
        "workflows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "role"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 3 }
            }
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementationRead",
        "runtimeCompared",
        "officialCasesInspected",
        "exampleSchemaValidated",
        "exampleExecuted",
        "russianEdited",
        "factsRecheckedAfterEditing"
      ],
      "properties": {
        "implementationRead": { "type": "boolean" },
        "runtimeCompared": { "type": "boolean" },
        "officialCasesInspected": { "type": "boolean" },
        "exampleSchemaValidated": { "type": "boolean" },
        "exampleExecuted": { "type": "boolean" },
        "russianEdited": { "type": "boolean" },
        "factsRecheckedAfterEditing": { "type": "boolean" }
      }
    },
    "knownGaps": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "updatedAt": { "type": "string", "format": "date" }
  }
}
